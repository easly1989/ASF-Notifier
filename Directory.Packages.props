<Project>
	<Import Project="ArchiSteamFarm/Directory.Packages.props" />

	<ItemGroup>
		<!-- ASF gets NLog through NLog.Web.AspNetCore; keep this equal to the NLog version ASF resolves, the plugin uses ASF's copy at runtime -->
		<PackageVersion Include="NLog" Version="6.2.1" />
	</ItemGroup>
</Project>
